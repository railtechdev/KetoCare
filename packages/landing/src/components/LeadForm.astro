---
/**
 * Форма заявки — одна на странице, в блоке с якорем `#lead`.
 *
 * Поле одно — почта; выбор «врач или семья» нужен администратору, чтобы
 * понимать, какой разговор его ждёт (ADR-0012: заявки двух видов). Заявка
 * попадает в раздел «Заявки» кабинета администратора. Срока ответа форма не
 * обещает: уведомления о новой заявке в продукте нет, и названный срок был бы
 * обещанием, которое некому выполнить.
 *
 * Поле проверяет браузер (`type="email" required`) — его сообщение уже на
 * языке посетителя. Наш блок ошибки говорит то, чего браузер знать не может:
 * сеть не ответила, сервер отверг адрес, сработало ограничение частоты.
 *
 * Без JavaScript форма не отправится, поэтому вместо неё показывается почта —
 * молчаливая кнопка, которая ничего не делает, хуже честной ссылки.
 */
import { useTranslations } from "../i18n";
import type { Locale } from "../i18n/config";
import { CONTACT_EMAIL, LEADS_ENDPOINT } from "../site";

interface Props {
  locale: Locale;
  /** Какой вариант выбран сразу: на странице врачам — «врач или клиника». */
  audience?: "doctor" | "family";
}

const { locale, audience = "doctor" } = Astro.props;
const d = useTranslations(locale);
const f = d.leadForm;
---

<div class="lead-box" data-lead>
  <form
    class="lead-form"
    data-lead-form
    action={LEADS_ENDPOINT}
    method="post"
    data-error-email={f.errorEmail}
    data-error-network={f.errorNetwork}
    data-error-rate={f.errorRateLimited}
    data-contact-email={CONTACT_EMAIL}
    data-sending={f.sending}
  >
    <fieldset class="choice-group">
      <legend class="field-label">{f.audienceLegend}</legend>
      <label class="choice">
        <input
          type="radio"
          name="audience"
          value="doctor"
          checked={audience === "doctor"}
        />
        <span>{f.audienceDoctor}</span>
      </label>
      <label class="choice">
        <input
          type="radio"
          name="audience"
          value="family"
          checked={audience === "family"}
        />
        <span>{f.audienceFamily}</span>
      </label>
    </fieldset>

    <label class="field-label" for="lead-email">{f.emailLabel}</label>
    <div class="lead-form__row">
      <input
        class="input"
        type="email"
        id="lead-email"
        name="email"
        required
        autocomplete="email"
        spellcheck="false"
        placeholder={f.emailPlaceholder}
      />
      {
        /* Приманка для ботов: человек это поле не видит и не заполняет. Имя не
          `company`: менеджеры паролей подставляют организацию даже в скрытое
          поле, и живой посетитель молча терял бы заявку. */
      }
      <input
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
        class="visually-hidden"
        aria-hidden="true"
      />
      <button class="btn btn--primary" type="submit">{f.submit}</button>
    </div>
    <p class="lead-form__error" data-lead-error hidden role="alert"></p>
    <p class="lead-form__consent">{f.consent}</p>
  </form>

  <div class="lead-done" data-lead-done tabindex="-1" hidden>
    <p class="lead-done__title">{f.doneTitle}</p>
    <p class="lead-done__text" data-lead-done-text data-template={f.doneText}>
    </p>
    <button class="btn btn--secondary" type="button" data-lead-again>
      {f.again}
    </button>
  </div>

  <p class="lead-box__noscript">
    <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
  </p>
</div>
