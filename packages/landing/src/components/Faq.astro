---
/**
 * Частые вопросы — `<details>` с общим `name`: браузер сам держит открытым
 * один ответ, без скрипта. Где `name` не поддерживается, ответы просто
 * раскрываются независимо — текст доступен в любом случае, и поисковику
 * тоже.
 */
import { useTranslations } from "../i18n";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = useTranslations(locale);
---

<div class="faq">
  {
    d.home.faq.items.map((item) => (
      <details class="faq__item" name="faq">
        <summary class="faq__q">
          <span>{item.q}</span>
          <span class="faq__sign" aria-hidden="true" />
        </summary>
        <p class="faq__a">{item.a}</p>
      </details>
    ))
  }
</div>
