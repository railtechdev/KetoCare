---
/**
 * Шапка: логотип, три раздела, «Войти», одна главная кнопка, язык.
 *
 * Полная строка помещается от 1200 px. Уже — разделы, «Войти» и тема уходят
 * в меню-значок, а язык остаётся на виду всегда: человек, открывший сайт не
 * на своём языке, не должен искать переключатель в меню. Главная кнопка видна
 * с 640 px, на телефоне — первой строкой меню.
 *
 * Прежняя шапка ставила девять элементов в строку без переноса, и с 941 до
 * 1215 px страница становилась шире окна. Ширины разбора — в
 * docs/AUDIT_PRODUCT_2026-11.md, раздел 1.
 */
import { useTranslations } from "../i18n";
import { pagePath, type Locale, type PageKey } from "../i18n/config";
import { LOGIN_URL } from "../site";
import LangSwitcher from "./LangSwitcher.astro";

interface Props {
  locale: Locale;
  page: PageKey;
  leadHref: string;
}

const { locale, page, leadHref } = Astro.props;
const d = useTranslations(locale);

const links: { key: PageKey; label: string }[] = [
  { key: "doctors", label: d.nav.doctors },
  { key: "forFamilies", label: d.nav.families },
  { key: "howItWorks", label: d.nav.howItWorks },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={pagePath("home", locale)}>
      <span class="brand__mark" aria-hidden="true">{d.common.brandMark}</span>
      <span class="brand__name">{d.common.brand}</span>
    </a>

    <nav class="nav" id="site-nav" aria-label={d.common.mainNav}>
      <a class="btn btn--primary nav__cta" href={leadHref}>{d.nav.lead}</a>
      <ul class="nav__links">
        {
          links.map((link) => (
            <li>
              <a
                class="nav__link"
                href={pagePath(link.key, locale)}
                aria-current={page === link.key ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="nav__link nav__login" href={LOGIN_URL}>{d.nav.login}</a>
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-pressed="false"
        title={d.common.toggleTheme}
      >
        <svg
          class="theme-toggle__icon"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
        <span class="theme-toggle__label">{d.common.toggleTheme}</span>
      </button>
    </nav>

    <div class="site-header__end">
      <a class="btn btn--primary header-cta" href={leadHref}>{d.nav.lead}</a>
      <LangSwitcher
        locale={locale}
        page={page}
        label={d.common.languageLabel}
      />
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-nav-toggle
        data-label-open={d.common.openMenu}
        data-label-close={d.common.closeMenu}
      >
        <span class="nav-toggle__bars" aria-hidden="true"
          ><i></i><i></i><i></i></span
        >
        <span class="nav-toggle__label" data-nav-toggle-label
          >{d.common.openMenu}</span
        >
      </button>
    </div>
  </div>
</header>
