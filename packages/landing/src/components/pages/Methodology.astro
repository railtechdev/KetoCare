---
/**
 * Как приложение считает и кто принимает решения — простыми словами.
 *
 * Страница в шапку не вынесена (на неё ведут «Как это работает», блок
 * безопасности на главной и подвал): это ответ на вопрос «а можно ли этому
 * доверять», и задают его после того, как поняли, что продукт делает.
 */
import { useTranslations } from "../../i18n";
import { pagePath, type Locale } from "../../i18n/config";
import Layout from "../../layouts/Layout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = useTranslations(locale);
const p = d.methodology;
---

<Layout
  locale={locale}
  page="methodology"
  title={p.seo.title}
  description={p.seo.description}
>
  <section class="page-hero">
    <div class="wrap wrap--text">
      <h1 class="h1">{p.hero.h1}</h1>
      <p class="lead">{p.hero.lead}</p>
    </div>
  </section>

  <section class="section section--alt section--tight-top">
    <div class="wrap wrap--text stack">
      {
        p.sections.map((section, i) => (
          <article class="card card--wide" aria-labelledby={`h-m${i}`}>
            <h2 class="h3" id={`h-m${i}`}>
              {section.title}
            </h2>
            <ul class="tick-list">
              {section.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
      <div class="btn-row">
        <a class="btn btn--primary" href={`${pagePath("home", locale)}#lead`}
          >{d.nav.lead}</a
        >
        <a class="btn btn--secondary" href={pagePath("howItWorks", locale)}
          >{d.nav.howItWorks}</a
        >
      </div>
    </div>
  </section>
</Layout>
