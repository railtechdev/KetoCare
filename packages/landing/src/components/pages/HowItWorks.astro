---
import { useTranslations } from "../../i18n";
import { pagePath, type Locale } from "../../i18n/config";
import Layout from "../../layouts/Layout.astro";
import Screen from "../Screen.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = useTranslations(locale);
const p = d.how;
---

<Layout
  locale={locale}
  page="howItWorks"
  title={p.seo.title}
  description={p.seo.description}
>
  <section class="page-hero">
    <div class="wrap wrap--text">
      <h1 class="h1">{p.hero.h1}</h1>
      <p class="lead">{p.hero.lead}</p>
    </div>
  </section>

  <section class="section section--alt section--tight-top">
    <div class="wrap split split--steps">
      <ol class="timeline">
        {
          p.steps.map((step) => (
            <li class="timeline__item">
              <p class="timeline__who">{step.who}</p>
              <h2 class="h3">{step.title}</h2>
              <ul class="tick-list">
                {step.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
      <div class="split__media split__media--sticky">
        <Screen id="ketones" locale={locale} />
        <Screen id="appDiary" locale={locale} crop class="shot--small" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-channels">
    <div class="wrap">
      <h2 class="h2" id="h-channels">{p.channels.h2}</h2>
      <ul class="cards cards--3">
        {
          p.channels.items.map((item) => (
            <li class="card">
              <h3 class="h3">{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="h-roles">
    <div class="wrap">
      <h2 class="h2" id="h-roles">{p.roles.h2}</h2>
      <ul class="cards">
        {
          p.roles.items.map((item) => (
            <li class="card">
              <h3 class="h3">{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="more-line">
        {p.more.text}{" "}
        <a class="text-link" href={pagePath("methodology", locale)}
          >{p.more.link}</a
        >
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href={`${pagePath("home", locale)}#lead`}
          >{d.nav.lead}</a
        >
        <a class="btn btn--secondary" href={pagePath("doctors", locale)}
          >{d.nav.doctors}</a
        >
        <a class="btn btn--secondary" href={pagePath("forFamilies", locale)}
          >{d.nav.families}</a
        >
      </div>
    </div>
  </section>
</Layout>
