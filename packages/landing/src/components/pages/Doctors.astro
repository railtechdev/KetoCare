---
import { useTranslations } from "../../i18n";
import { pagePath, type Locale } from "../../i18n/config";
import Layout from "../../layouts/Layout.astro";
import Feature from "../Feature.astro";
import LeadForm from "../LeadForm.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = useTranslations(locale);
const p = d.doctors;
---

<Layout
  locale={locale}
  page="doctors"
  title={p.seo.title}
  description={p.seo.description}
  hasLead
>
  <section class="page-hero">
    <div class="wrap wrap--text">
      <h1 class="h1">{p.hero.h1}</h1>
      <p class="lead">{p.hero.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="#lead">{d.nav.lead}</a>
        <a class="btn btn--secondary" href={pagePath("howItWorks", locale)}
          >{d.nav.howItWorks}</a
        >
      </div>
    </div>
  </section>

  <Feature
    locale={locale}
    id="patients"
    title={p.patients.title}
    text={p.patients.text}
    points={p.patients.points}
    shot="patients"
    alt
  />
  <Feature
    locale={locale}
    id="prescription"
    title={p.prescription.title}
    text={p.prescription.text}
    points={p.prescription.points}
    shot="prescription"
    reverse
  />
  <Feature
    locale={locale}
    id="menu"
    title={p.menu.title}
    text={p.menu.text}
    points={p.menu.points}
    shot="menu"
    alt
  />
  <Feature
    locale={locale}
    id="diaries"
    title={p.diaries.title}
    text={p.diaries.text}
    points={p.diaries.points}
    shot="seizures"
    reverse
  />
  <Feature
    locale={locale}
    id="growth"
    title={p.growth.title}
    text={p.growth.text}
    points={p.growth.points}
    shot="growth"
    alt
  />

  <section class="section" aria-labelledby="h-connect">
    <div class="wrap">
      <h2 class="h2" id="h-connect">{p.connect.h2}</h2>
      <ol class="steps steps--3">
        {
          p.connect.items.map((item) => (
            <li class="steps__item">
              <h3 class="h3">{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt" id="lead" aria-labelledby="h-lead">
    <div class="wrap lead-section">
      <div>
        <h2 class="h2" id="h-lead">{p.lead.h2}</h2>
        <p class="lead">{p.lead.text}</p>
      </div>
      <LeadForm locale={locale} audience="doctor" />
    </div>
  </section>
</Layout>
