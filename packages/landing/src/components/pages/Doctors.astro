---
import { useTranslations } from "../../i18n";
import { pagePath, type Locale } from "../../i18n/config";
import Layout from "../../layouts/Layout.astro";
import LeadForm from "../LeadForm.astro";
import { CONTACT_EMAIL } from "../../site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = useTranslations(locale);
const p = d.doctors;
const g = p.benefits.grid;
---

<Layout
  locale={locale}
  page="doctors"
  title={p.seo.title}
  description={p.seo.description}
  ctaHref="#pilot"
  ctaLabel={d.nav.pilot}
>
  <section class="hero dark-section">
    <div
      class="hero__glow"
      aria-hidden="true"
      style="top:-160px;left:-140px;width:520px;height:520px;background:radial-gradient(closest-side,rgb(127 166 255 / 16%),transparent 70%)"
    >
    </div>
    <div class="wrap hero__inner split">
      <div class="split__text">
        <p class="eyebrow">{p.hero.eyebrow}</p>
        <h1 class="h1" style="margin-bottom:20px">{p.hero.h1}</h1>
        <p class="lead measure--tight" style="margin-bottom:30px">
          {p.hero.lead}
        </p>
        <div class="btn-row">
          <a class="btn btn--on-dark" href="#pilot">{p.hero.ctaPilot}</a>
          <a class="btn btn--ghost-dark" href={pagePath("howItWorks", locale)}
            >{p.hero.ctaHow}</a
          >
        </div>
      </div>

      <div class="split__media reveal">
        <div class="mock" style="max-width:420px;color:var(--ink)">
          <div class="mock__row">
            <strong>{p.hero.card.title}</strong>
            <span
              style="font-size:.75rem;font-weight:600;color:var(--success);background:var(--success-bg);border-radius:8px;padding:3px 10px"
              >{p.hero.card.badge}</span
            >
          </div>
          <dl
            style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0"
          >
            {
              [
                [p.hero.card.ratioLabel, p.hero.card.ratioValue],
                [p.hero.card.caloriesLabel, p.hero.card.caloriesValue],
                [p.hero.card.proteinLabel, p.hero.card.proteinValue],
                [p.hero.card.carbsLabel, p.hero.card.carbsValue],
              ].map(([label, value]) => (
                <div style="background:var(--surface-sunken);border-radius:13px;padding:13px 15px">
                  <dt style="font-size:.75rem;color:var(--ink-muted);margin-bottom:2px">
                    {label}
                  </dt>
                  <dd
                    class="num"
                    style="margin:0;font-weight:700;font-size:1.19rem"
                  >
                    {value}
                  </dd>
                </div>
              ))
            }
          </dl>
          <div
            style="margin-top:12px;display:flex;justify-content:space-between;align-items:center;gap:12px;background:var(--bg);border:1px solid var(--border);border-radius:13px;padding:12px 15px"
          >
            <span style="font-size:.84rem;color:var(--ink-muted)"
              >{p.hero.card.mealsLabel}</span
            >
            <span class="num" style="font-weight:700;font-size:1rem"
              >{p.hero.card.mealsValue}</span
            >
          </div>
          <p
            style="margin-top:12px;font-size:.78rem;color:var(--ink-muted);line-height:1.5"
          >
            {p.hero.card.note}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- Что получает врач ---------- */}
  <section
    class="section section--white"
    style="border-bottom:1px solid var(--border)"
  >
    <div class="wrap reveal">
      <h2 class="h2" style="max-width:26ch;margin-bottom:44px">
        {p.benefits.h2}
      </h2>
      <div class="grid grid--auto">
        <div class="card card--sunken">
          <h3 class="card__title">{p.benefits.queue.title}</h3>
          <p class="card__text" style="margin-bottom:16px">
            {p.benefits.queue.text}
          </p>
          <ul style="display:flex;flex-direction:column;gap:8px">
            {
              p.benefits.queue.rows.map((row) => (
                <li style="display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:10px 14px;font-size:.84rem">
                  <span
                    aria-hidden="true"
                    style={`width:9px;height:9px;border-radius:50%;flex:none;background:${
                      row.level === "danger"
                        ? "var(--danger)"
                        : "var(--warn-mark)"
                    }`}
                  />
                  <strong>{row.name}</strong>
                  <span style="color:var(--ink-muted)">{row.reason}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card card--sunken">
          <h3 class="card__title">{p.benefits.chart.title}</h3>
          <p class="card__text" style="margin-bottom:16px">
            {p.benefits.chart.text}
          </p>
          <svg
            viewBox="0 0 280 84"
            role="img"
            aria-label={p.benefits.chart.chartAlt}
          >
            <line
              x1="150"
              y1="6"
              x2="150"
              y2="78"
              stroke="#7a6ede"
              stroke-width="1.5"
              stroke-dasharray="4 4"></line>
            <polyline
              points="10,64 40,60 70,57 100,55 130,54 150,53 170,44 200,36 230,30 270,26"
              fill="none"
              stroke="var(--primary)"
              stroke-width="2.5"
              stroke-linecap="round"></polyline>
            <circle cx="270" cy="26" r="4" fill="var(--primary)"></circle>
          </svg>
          <p
            style="font-size:.75rem;color:#5d51b8;font-weight:600;margin-top:6px"
          >
            <span aria-hidden="true">— — </span>{p.benefits.chart.legend}
          </p>
        </div>

        <div class="card card--sunken">
          <h3 class="card__title">{p.benefits.report.title}</h3>
          <p class="card__text" style="margin-bottom:16px">
            {p.benefits.report.text}
          </p>
          <div
            style="background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:14px;font-size:.8rem;line-height:1.7;color:var(--ink-muted)"
          >
            <strong style="color:var(--ink);display:block;margin-bottom:4px"
              >{p.benefits.report.sampleTitle}</strong
            >
            {p.benefits.report.sampleLines.map((line) => <div>{line}</div>)}
          </div>
        </div>

        <div class="card card--sunken">
          <h3 class="card__title">{g.title}</h3>
          <p class="card__text" style="margin-bottom:16px">{g.text}</p>
          <div class="seizure-grid">
            <table>
              <caption class="visually-hidden">{g.caption}</caption>
              <thead>
                <tr>
                  <th scope="col">{g.colType}</th>
                  <th scope="col">{g.colMorning}</th>
                  <th scope="col">{g.colDay}</th>
                  <th scope="col">{g.colEvening}</th>
                  <th scope="col">{g.colNight}</th>
                </tr>
              </thead>
              <tbody>
                {
                  g.rows.map((row) => (
                    <tr>
                      <th scope="row">{row.type}</th>
                      {row.values.map((v) => (
                        <td data-empty={v === "·" ? "" : undefined}>{v}</td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- Клиническая строгость ---------- */}
  <section class="section section--sand">
    <div class="wrap reveal">
      <p class="eyebrow">{p.rigor.eyebrow}</p>
      <h2 class="h2" style="max-width:28ch;margin-bottom:44px">{p.rigor.h2}</h2>
      <div class="grid grid--auto-sm">
        {
          p.rigor.items.map((item) => (
            <div class="card card--sand">
              <h3 class="card__title">{item.title}</h3>
              <p class="card__text">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- Подключение семей ---------- */}
  <section class="section">
    <div class="wrap reveal">
      <h2 class="h2" style="max-width:24ch;margin-bottom:14px">
        {p.onboarding.h2}
      </h2>
      <p class="lead measure" style="margin-bottom:40px">{p.onboarding.lead}</p>
      <div class="grid grid--auto">
        {
          p.onboarding.items.map((item) => (
            <div class="card">
              <h3 class="card__title" style="font-size:1.03rem">
                {item.title}
              </h3>
              <p class="card__text">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- Пилот ---------- */}
  <section
    class="section section--white"
    style="border-top:1px solid var(--border)"
  >
    <div class="wrap reveal">
      <h2 class="h2" style="max-width:22ch;margin-bottom:44px">{p.pilot.h2}</h2>
      <div class="grid grid--auto">
        {
          p.pilot.items.map((item, i) => (
            <div class="card card--sunken">
              <div class="card__num" aria-hidden="true">
                {i + 1}
              </div>
              <h3 class="card__title" style="font-size:1.03rem">
                {item.title}
              </h3>
              <p class="card__text">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- Заявка ---------- */}
  <section class="section dark-section" id="pilot">
    <div class="wrap wrap--text" style="text-align:center">
      <h2 class="h2" style="margin-bottom:14px">{p.ctaForm.h2}</h2>
      <p
        class="lead"
        style="max-width:52ch;margin-inline:auto;margin-bottom:32px"
      >
        {p.ctaForm.lead}
      </p>
      <LeadForm locale={locale} variant="doctor" />
      <p style="margin-top:22px;font-size:.84rem;color:var(--dark-muted)">
        {p.ctaForm.direct}
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    </div>
  </section>
</Layout>
