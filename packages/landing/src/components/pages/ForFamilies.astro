---
import { useTranslations } from "../../i18n";
import { pagePath, type Locale } from "../../i18n/config";
import Layout from "../../layouts/Layout.astro";
import { JOIN_URL } from "../../site";
import Feature from "../Feature.astro";
import KetoCalculator from "../KetoCalculator.astro";
import Screen from "../Screen.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = useTranslations(locale);
const p = d.families;
---

<Layout
  locale={locale}
  page="forFamilies"
  title={p.seo.title}
  description={p.seo.description}
>
  <section class="hero">
    <div class="wrap hero__grid hero__grid--phone">
      <div class="hero__text">
        <h1 class="h1">{p.hero.h1}</h1>
        <p class="lead">{p.hero.lead}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={JOIN_URL}>{p.hero.codeCta}</a>
          <a class="btn btn--secondary" href={pagePath("howItWorks", locale)}
            >{d.nav.howItWorks}</a
          >
        </div>
      </div>
      <div class="hero__media">
        <Screen id="appHome" locale={locale} eager crop />
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="h-start">
    <div class="wrap">
      <h2 class="h2" id="h-start">{p.start.title}</h2>
      <ol class="steps steps--3">
        {
          p.start.points.map((point) => (
            <li class="steps__item">
              <p>{point}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Feature
    locale={locale}
    id="menu"
    title={p.menu.title}
    text={p.menu.text}
    points={p.menu.points}
    shot="appMenu"
  />

  <section class="section section--alt" aria-labelledby="h-calc">
    <div class="wrap split split--calc">
      <div class="split__text">
        <h2 class="h2" id="h-calc">{p.calc.title}</h2>
        <p class="lead">{p.calc.text}</p>
      </div>
      <div class="split__media">
        <KetoCalculator locale={locale} />
      </div>
    </div>
  </section>

  <Feature
    locale={locale}
    id="diary"
    title={p.diary.title}
    text={p.diary.text}
    points={p.diary.points}
    shot="appDiary"
    reverse
  />

  <Feature
    locale={locale}
    id="help"
    title={p.help.title}
    points={p.help.points}
    alt
  />

  <section class="section" aria-labelledby="h-end">
    <div class="wrap wrap--text center">
      <h2 class="h2" id="h-end">{p.end.h2}</h2>
      <p class="lead">{p.end.text}</p>
      <div class="btn-row btn-row--center">
        <a class="btn btn--primary" href={`${pagePath("home", locale)}#lead`}
          >{d.nav.lead}</a
        >
        <a class="btn btn--secondary" href={JOIN_URL}>{d.nav.enterCode}</a>
      </div>
    </div>
  </section>
</Layout>
