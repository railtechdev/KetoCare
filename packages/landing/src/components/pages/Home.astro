---
/**
 * Главная. Порядок блоков — вопросы посетителя по очереди: что это (первый
 * экран со снимком продукта), что получает врач, что получает семья, как это
 * устроено, насколько это безопасно, частые вопросы, заявка.
 *
 * Мерило длины — телефон: не больше семи экранов на 360 px (прежняя главная
 * занимала шестнадцать с половиной), на ноутбуке 1440 × 900 — не больше
 * четырёх. Подробности живут на страницах разделов, сюда — по пять строк.
 */
import { useTranslations } from "../../i18n";
import { pagePath, type Locale } from "../../i18n/config";
import Layout from "../../layouts/Layout.astro";
import { JOIN_URL } from "../../site";
import Faq from "../Faq.astro";
import LeadForm from "../LeadForm.astro";
import Screen from "../Screen.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = useTranslations(locale);
const h = d.home;

/** Микроразметка вопросов: даёт им шанс попасть в блок ответов поисковика. */
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: h.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  locale={locale}
  page="home"
  title={h.seo.title}
  description={h.seo.description}
  hasLead
  schema={faqSchema}
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1 class="h1">{h.hero.h1}</h1>
        <p class="lead">{h.hero.lead}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="#lead">{h.hero.ctaPrimary}</a>
          <a class="btn btn--secondary" href={pagePath("howItWorks", locale)}
            >{h.hero.ctaSecondary}</a
          >
        </div>
        <p class="hero__code">
          {h.hero.codeHint}
          <a class="text-link" href={JOIN_URL}>{d.nav.enterCode}</a>
        </p>
      </div>
      <div class="hero__media duo">
        <Screen id="overview" locale={locale} eager caption={false} />
        <Screen
          id="appHome"
          locale={locale}
          eager
          caption={false}
          crop
          class="duo__phone"
        />
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="h-doctor">
    <div class="wrap split">
      <div class="split__text">
        <h2 class="h2" id="h-doctor">{h.doctor.h2}</h2>
        <ul class="tick-list">
          {h.doctor.items.map((item) => <li>{item}</li>)}
        </ul>
        <a class="more-link" href={pagePath("doctors", locale)}
          >{h.doctor.more}<span aria-hidden="true"> →</span></a
        >
      </div>
      <div class="split__media">
        <Screen id="patients" locale={locale} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-family">
    <div class="wrap split split--reverse split--phone">
      <div class="split__text">
        <h2 class="h2" id="h-family">{h.family.h2}</h2>
        <ul class="tick-list">
          {h.family.items.map((item) => <li>{item}</li>)}
        </ul>
        <a class="more-link" href={pagePath("forFamilies", locale)}
          >{h.family.more}<span aria-hidden="true"> →</span></a
        >
      </div>
      <div class="split__media hide-narrow">
        <Screen id="appMenu" locale={locale} crop />
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="h-steps">
    <div class="wrap">
      <h2 class="h2" id="h-steps">{h.steps.h2}</h2>
      <ol class="steps">
        {
          h.steps.items.map((step) => (
            <li class="steps__item">
              <h3 class="h3">{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <a class="more-link" href={pagePath("howItWorks", locale)}
        >{h.steps.more}<span aria-hidden="true"> →</span></a
      >
    </div>
  </section>

  <section class="section" aria-labelledby="h-safety">
    <div class="wrap">
      <h2 class="h2" id="h-safety">{h.safety.h2}</h2>
      <ul class="cards">
        {
          h.safety.items.map((item) => (
            <li class="card">
              <h3 class="h3">{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
      <a class="more-link" href={pagePath("methodology", locale)}
        >{h.safety.more}<span aria-hidden="true"> →</span></a
      >
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap faq-lead">
      <div aria-labelledby="h-faq" role="region">
        <h2 class="h2" id="h-faq">{h.faq.h2}</h2>
        <Faq locale={locale} />
      </div>
      <div id="lead" aria-labelledby="h-lead" role="region">
        <h2 class="h2" id="h-lead">{h.lead.h2}</h2>
        <p class="lead lead--tight">{h.lead.text}</p>
        <LeadForm locale={locale} />
      </div>
    </div>
  </section>
</Layout>
