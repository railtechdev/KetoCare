---
/**
 * Демонстрационный калькулятор. Значения по умолчанию считаются на сборке,
 * поэтому без JavaScript посетитель видит корректный расчёт — просто без
 * возможности двигать ползунки.
 *
 * Вердикт стоит НАД ползунками: на телефоне четыре ползунка занимают экран, и
 * вердикт под ними двигали вслепую — ответ на вопрос «подходит ли блюдо»
 * оказывался ниже сгиба.
 */
import { t, useTranslations } from "../i18n";
import type { Locale } from "../i18n/config";
import {
  calculate,
  formatNumber,
  INGREDIENTS,
  TARGET_RATIO,
  TOLERANCE,
} from "../lib/keto";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = useTranslations(locale);
const c = d.calc;

const initial = INGREDIENTS.map((i) => i.initial);
const r = calculate(initial);

const verdictText = { ok: c.verdictOk, low: c.verdictLow, high: c.verdictHigh };

/** Строки, которые скрипту нужны в браузере: словаря у него нет. */
const configJson = JSON.stringify({
  target: TARGET_RATIO,
  tolerance: TOLERANCE,
  locale,
  grams: d.common.grams,
  kcal: d.common.kcal,
  netCarbs: c.netCarbs,
  verdict: verdictText,
}).replaceAll("<", "\\u003c");

const grams = (value: number) =>
  `${formatNumber(value, locale)}\u00a0${d.common.grams}`;
---

<div class="calc" data-calc>
  <div class="calc__head">
    <div>
      <p class="calc__dish">{c.dish}</p>
      <p class="calc__target">{c.target}</p>
    </div>
    <p class="calc__kcal num" data-calc-kcal>
      {Math.round(r.kcal)}&nbsp;{d.common.kcal}
    </p>
  </div>

  <div class="calc__verdict" data-calc-verdict data-state={r.state}>
    <p class="calc__ratio num" data-calc-ratio>
      {formatNumber(r.ratio, locale, 2)} : 1
    </p>
    <p
      class="calc__verdict-text"
      data-calc-verdict-text
      role="status"
      aria-live="polite"
    >
      {verdictText[r.state]}
    </p>
  </div>

  <div class="macro-bar" aria-hidden="true">
    <span
      class="macro-bar__fat"
      style={`width:${r.fatPct.toFixed(1)}%`}
      data-calc-bar="fat"></span>
    <span
      class="macro-bar__protein"
      style={`width:${r.proteinPct.toFixed(1)}%`}
      data-calc-bar="protein"></span>
    <span
      class="macro-bar__carbs"
      style={`width:${r.carbsPct.toFixed(1)}%`}
      data-calc-bar="carbs"></span>
  </div>
  <dl class="macro-legend">
    <div>
      <dt>
        <i class="macro-dot macro-dot--fat" aria-hidden="true"></i>{
          d.common.fat
        }
      </dt>
      <dd class="num" data-calc-macro="fat">{grams(r.fat)}</dd>
    </div>
    <div>
      <dt>
        <i class="macro-dot macro-dot--protein" aria-hidden="true"></i>{
          d.common.protein
        }
      </dt>
      <dd class="num" data-calc-macro="protein">{grams(r.protein)}</dd>
    </div>
    <div>
      <dt>
        <i class="macro-dot macro-dot--carbs" aria-hidden="true"></i>{
          d.common.carbs
        }
      </dt>
      <dd class="num" data-calc-macro="carbs">{grams(r.carbs)}</dd>
    </div>
  </dl>

  <div class="calc__sliders">
    {
      INGREDIENTS.map((ing, i) => (
        <div class="calc__ing">
          <div class="calc__ing-row">
            <label for={`calc-ing-${i}`}>{c.ingredients[i]}</label>
            <output class="num" for={`calc-ing-${i}`} data-calc-grams={i}>
              {ing.initial}&nbsp;{d.common.grams}
            </output>
          </div>
          <input
            type="range"
            id={`calc-ing-${i}`}
            min="0"
            max={ing.max}
            step="5"
            value={ing.initial}
            data-calc-input={i}
            aria-label={t(c.sliderLabel, { name: c.ingredients[i] ?? "" })}
          />
        </div>
      ))
    }
  </div>

  <p class="calc__note" data-calc-net-carbs>
    {t(c.netCarbs, { value: grams(r.netCarbs) })}
  </p>
  <p class="calc__note">{c.disclaimer}</p>

  <script
    is:inline
    type="application/json"
    data-calc-config
    set:html={configJson}
  />
</div>
