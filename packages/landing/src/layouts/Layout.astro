---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource-variable/source-serif-4";
import "../styles/global.css";

import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { useTranslations } from "../i18n";
import { HTML_LANG, pagePath, type Locale, type PageKey } from "../i18n/config";
import { CONTACT_EMAIL, TELEGRAM_URL } from "../site";

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  /** Стоит ли на странице форма заявки (`#lead`). Иначе кнопка «Оставить
   *  заявку» ведёт к форме на главной. */
  hasLead?: boolean;
  /** Микроразметка страницы (FAQPage и т. п.) сверх общей Organization. */
  schema?: unknown;
  notFound?: boolean;
}

const {
  locale,
  page,
  title,
  description,
  hasLead = false,
  schema,
  notFound = false,
} = Astro.props;
const d = useTranslations(locale);
const leadHref = hasLead ? "#lead" : `${pagePath("home", locale)}#lead`;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "KetoCare",
  url: Astro.site?.href,
  description: d.home.seo.description,
  email: CONTACT_EMAIL,
  sameAs: [TELEGRAM_URL],
};
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <BaseHead
      locale={locale}
      page={page}
      title={title}
      description={description}
      notFound={notFound}
    />
    <script
      is:inline
      set:html={JSON.stringify(organization)}
      type="application/ld+json"
    />
    {
      schema && (
        <script
          is:inline
          set:html={JSON.stringify(schema)}
          type="application/ld+json"
        />
      )
    }
    {
      /* Файлом, а не инлайном: с политикой содержимого (`script-src 'self'`)
        инлайновый скрипт не выполнится, а хеш в политике пришлось бы править
        вместе с каждой правкой скрипта. Синхронный, без `defer`: тема должна
        стоять до первой отрисовки, иначе страница мигает. Содержимое и
        причины — в `public/boot.js`. */
    }
    <script is:inline src="/boot.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{d.common.skipToContent}</a>
    <Header locale={locale} page={page} leadHref={leadHref} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
