---
/**
 * Языковые версии главной. Русская лежит в корне (`/`), поэтому здесь только
 * узбекская и английская — их и перечисляет getStaticPaths.
 */
import Home from "../../components/pages/Home.astro";
import { DEFAULT_LOCALE, LOCALES, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<Home locale={locale} />
