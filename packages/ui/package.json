{
  "name": "@ketocare/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Дизайн-система KetoCare: токены и общие компоненты для apps/web и apps/miniapp.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/tokens.css",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
