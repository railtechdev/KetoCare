    "format": "prettier --write src",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hookform/resolvers": "^5",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-table": "^8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.78.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "^7",
    "recharts": "^2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
