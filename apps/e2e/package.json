{
  "name": "@ketocare/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "install-browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src tests playwright.config.ts global-setup.ts",
    "format": "prettier --write src tests playwright.config.ts global-setup.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
