# Копия для локальной разработки: cp .env.example .env
# Значения ниже — фиктивные. Реальные секреты в репозиторий не попадают (см. CLAUDE.md, правило 7).

DATABASE_URL=postgresql+asyncpg://ketocare:ketocare@localhost:5432/ketocare
REDIS_URL=redis://localhost:6379/0

# Пароль postgres для infra/docker-compose.prod.yml (пред-прод/прод). Строку
# подключения контейнеры собирают из него сами — DATABASE_URL выше про это
# значение знать не должен, он для локальной разработки. См. docs/DEPLOY.md.
POSTGRES_PASSWORD=change-me-on-server

SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-48
BOT_TOKEN=000000:dev-bot-token             # Telegram Bot API token
BOT_API_TOKEN=dev-bot-service-token        # сервисный токен бота для API
BOT_USERNAME=ketocare_dev_bot              # имя бота без «@» — из него собирается deep-link привязки
BOT_API_BASE_URL=http://127.0.0.1:8001     # куда бот ходит за API (мимо веб-сервера)

ANTHROPIC_API_KEY=sk-ant-dev-placeholder
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-opus-5
AI_DAILY_BUDGET_USD=10
AI_USER_DAILY_LIMIT=30

# Том под собранные PDF-отчёты и срок жизни ссылки на файл (раздел 7.5 ТЗ).
# Каталог должен быть общим у API и воркера: воркер пишет, API отдаёт.
REPORTS_DIR=./var/reports

# Каталог вложений: фото рецептов и документы пациентов (ADR-0004). Вне webroot,
# раздаётся только ручкой. Обязан попадать в резервное копирование: pg_dump
# сохраняет строки таблицы, но не байты файлов.
ATTACHMENTS_DIR=./var/attachments
# Предел на все вложения одного пациента, мегабайт. Предел на файл (10 МБ) диск
# не защищает: сотня документов заполнит том так же, как один огромный файл.
ATTACHMENT_QUOTA_MB=100
REPORT_LINK_TTL_HOURS=24

# IP обратных прокси, которым можно доверять X-Forwarded-For (через запятую).
# Пусто = заголовок игнорируется, берётся адрес непосредственного пира.
TRUSTED_PROXY_IPS=

# Куда dev-сервер Vite проксирует /api (порт 8000 часто занят)
API_PROXY_TARGET=http://127.0.0.1:8001

# Порт веб-кабинета. По умолчанию 5173; задайте свой, если он занят другим
# проектом — `make web` и vite возьмут его отсюда.
WEB_PORT=5173

WEB_ORIGIN=http://localhost:5173
MINIAPP_ORIGIN=http://localhost:5174

# Посадочная страница (packages/landing, ADR-0012). Значения уходят в сборку:
# из них собираются canonical, hreflang, sitemap, ссылки «Войти» и контакты.
LANDING_SITE_URL=https://ketocare.railtech.uz
# Индексация поисковиками. Пусто = noindex: временный домен пред-прода в выдаче
# даёт дубли, которые после переезда придётся убирать вручную.
LANDING_INDEXABLE=
PUBLIC_APP_URL=https://app.ketocare.railtech.uz
PUBLIC_CONTACT_EMAIL=hello@ketocare.uz
PUBLIC_TELEGRAM_URL=https://t.me/ketocare

SENTRY_DSN=

TZ=Asia/Tashkent
